# ---- Java / Maven ----
target/
build/
# Keep legitimate `target` folders that happen to be in source trees
!**/src/main/**/target/
!**/src/test/**/target/
*.class
*.jar
*.war
*.ear
*.zip
*.tar.gz
*.rar
hs_err_pid*
replay_pid*

# Maven Wrapper (kept on purpose: .mvn/wrapper/maven-wrapper.properties)
.mvn/wrapper/maven-wrapper.jar

# ---- Spring Boot ----
# Local-only configuration overrides (never commit secrets)
application-local.yml
application-local.yaml
application-local.properties
application-secrets.*
*.env
.env
.env.*

# Initializr leftover
HELP.md

# ---- IntelliJ IDEA ----
.idea/
*.iml
*.ipr
*.iws
out/

# ---- VS Code ----
.vscode/
*.code-workspace

